{%- comment -%}
  RENDR FARM — 3D Printing News
  Renders the weekly roundup written by scripts/build-news.mjs.

  Styled to match the live storefront: light background, white cards with a
  thin neutral border and rounded corners, dark headings, grey body copy, and
  a blue "Read article →" link matching the site's "Learn More →" pattern.

  Data source, in order of preference:
    1. shop.metafields.rendr.news_3d_printing  (server-rendered — preferred)
    2. the "Fallback JSON URL" setting          (fetched in the browser)

  See docs/3d-printing-news.md for setup.
{%- endcomment -%}

{%- liquid
  assign news = shop.metafields.rendr.news_3d_printing.value
  assign items = news.items
  assign limit = section.settings.items_to_show
  # `size` on a missing metafield yields 0, so this stays safe before the
  # first run of the workflow.
  assign item_count = items | size
-%}

<div
  class="rf-news"
  id="rf-news-{{ section.id }}"
  {% if section.settings.json_url != blank %}data-json-url="{{ section.settings.json_url }}"{% endif %}
  data-limit="{{ limit }}"
  data-show-images="{{ section.settings.show_images }}"
  data-show-source="{{ section.settings.show_source }}"
  data-show-date="{{ section.settings.show_date }}"
  data-link-label="{{ section.settings.link_label | escape }}"
>
  <div class="rf-news__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="rf-news__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="rf-news__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if item_count > 0 -%}
      <ul class="rf-news__grid" role="list">
        {%- for item in items limit: limit -%}
          <li class="rf-news__card">
            <a
              class="rf-news__link"
              href="{{ item.url }}"
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              {%- if section.settings.show_images and item.image != blank -%}
                <span class="rf-news__thumb">
                  <img
                    src="{{ item.image }}"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  >
                </span>
              {%- endif -%}

              <span class="rf-news__body">
                {%- if section.settings.show_source or section.settings.show_date -%}
                  <span class="rf-news__meta">
                    {%- if section.settings.show_source -%}
                      <span class="rf-news__source">{{ item.source }}</span>
                    {%- endif -%}
                    {%- if section.settings.show_date and item.publishedAt != blank -%}
                      <time class="rf-news__date" datetime="{{ item.publishedAt }}">
                        {{- item.publishedAt | date: '%b %-d, %Y' -}}
                      </time>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                <span class="rf-news__title">{{ item.title }}</span>

                {%- if item.summary != blank -%}
                  <span class="rf-news__summary">{{ item.summary }}</span>
                {%- endif -%}

                {%- if section.settings.link_label != blank -%}
                  <span class="rf-news__cta">
                    {{ section.settings.link_label | escape }}
                    <span class="rf-news__arrow" aria-hidden="true">&rarr;</span>
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if news.generatedAt != blank -%}
        <p class="rf-news__updated">
          Updated {{ news.generatedAt | date: '%B %-d, %Y' }}
        </p>
      {%- endif -%}

    {%- elsif section.settings.json_url != blank -%}
      <ul class="rf-news__grid" role="list" data-rf-news-target hidden></ul>
      <p class="rf-news__updated" data-rf-news-updated hidden></p>
      <p class="rf-news__empty" data-rf-news-empty>Loading the latest headlines…</p>

    {%- else -%}
      <p class="rf-news__empty">
        No headlines yet — the weekly roundup will appear here once it runs.
      </p>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #shopify-section-{{ section.id }} .rf-news {
    --rf-accent: {{ section.settings.accent_color }};
    --rf-border: {{ section.settings.border_color }};
    --rf-card: {{ section.settings.card_color }};
    --rf-text: {{ section.settings.text_color }};
    --rf-muted: {{ section.settings.muted_text_color }};
    --rf-cols: {{ section.settings.columns_desktop }};
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: var(--rf-text);
  }
  #shopify-section-{{ section.id }} .rf-news__inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: {{ section.settings.heading_alignment }};
  }
  #shopify-section-{{ section.id }} .rf-news__heading {
    margin: 0 0 .75rem;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--rf-text);
  }
  #shopify-section-{{ section.id }} .rf-news__subheading {
    margin: 0 auto 2.5rem;
    max-width: 58ch;
    color: var(--rf-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .rf-news__grid {
    display: grid;
    grid-template-columns: repeat(var(--rf-cols), minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .rf-news__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .rf-news__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .rf-news__card {
    display: flex;
    background: var(--rf-card);
    border: 1px solid var(--rf-border);
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  #shopify-section-{{ section.id }} .rf-news__card:hover {
    border-color: var(--rf-accent);
    box-shadow: 0 6px 22px rgba(0, 0, 0, .07);
    transform: translateY(-3px);
  }
  #shopify-section-{{ section.id }} .rf-news__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .rf-news__link:focus-visible {
    outline: 2px solid var(--rf-accent);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .rf-news__thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--rf-border);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .rf-news__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .rf-news__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .6rem;
    padding: 1.5rem 1.5rem 1.6rem;
    flex: 1 1 auto;
  }
  #shopify-section-{{ section.id }} .rf-news__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    align-items: baseline;
    font-size: .7rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .rf-news__source {
    color: var(--rf-accent);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rf-news__date {
    color: var(--rf-muted);
  }
  #shopify-section-{{ section.id }} .rf-news__title {
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--rf-text);
  }
  #shopify-section-{{ section.id }} .rf-news__summary {
    font-size: .95rem;
    line-height: 1.55;
    color: var(--rf-muted);
  }
  #shopify-section-{{ section.id }} .rf-news__cta {
    margin-top: auto;
    padding-top: .5rem;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--rf-accent);
    font-size: .98rem;
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .rf-news__arrow {
    transition: transform .2s ease;
  }
  #shopify-section-{{ section.id }} .rf-news__link:hover .rf-news__arrow {
    transform: translateX(4px);
  }

  #shopify-section-{{ section.id }} .rf-news__updated,
  #shopify-section-{{ section.id }} .rf-news__empty {
    margin: 1.75rem 0 0;
    font-size: .82rem;
    color: var(--rf-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rf-news__card,
    #shopify-section-{{ section.id }} .rf-news__arrow { transition: none; }
    #shopify-section-{{ section.id }} .rf-news__card:hover { transform: none; }
    #shopify-section-{{ section.id }} .rf-news__link:hover .rf-news__arrow { transform: none; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('rf-news-{{ section.id }}');
    if (!root) return;

    // Publishers rotate and expire their images. Drop the thumbnail rather
    // than leaving an empty box behind — server-rendered cards included.
    function dropOnError(img) {
      img.addEventListener('error', function () {
        var thumb = img.closest('.rf-news__thumb');
        if (thumb) thumb.remove();
      });
    }
    Array.prototype.forEach.call(
      root.querySelectorAll('.rf-news__thumb img'),
      function (img) {
        if (img.complete && img.naturalWidth === 0) {
          var thumb = img.closest('.rf-news__thumb');
          if (thumb) thumb.remove();
          return;
        }
        dropOnError(img);
      }
    );

    var target = root.querySelector('[data-rf-news-target]');
    var jsonUrl = root.dataset.jsonUrl;
    // Server-rendered content already present, or nothing to fetch.
    if (!target || !jsonUrl) return;

    var empty = root.querySelector('[data-rf-news-empty]');
    var updated = root.querySelector('[data-rf-news-updated]');
    var limit = parseInt(root.dataset.limit, 10) || 6;
    var showImages = root.dataset.showImages === 'true';
    var showSource = root.dataset.showSource === 'true';
    var showDate = root.dataset.showDate === 'true';
    var linkLabel = root.dataset.linkLabel || '';

    function el(tag, className, text) {
      var node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function formatDate(iso) {
      var d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleDateString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric'
      });
    }

    function render(data) {
      var items = (data && data.items) || [];
      if (!items.length) {
        if (empty) empty.textContent = 'No headlines available right now.';
        return;
      }

      items.slice(0, limit).forEach(function (item) {
        if (!item.url || !item.title) return;

        var link = el('a', 'rf-news__link');
        link.href = item.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer nofollow';

        if (showImages && item.image) {
          var thumb = el('span', 'rf-news__thumb');
          var img = new Image();
          img.src = item.image;
          img.alt = '';
          img.loading = 'lazy';
          img.referrerPolicy = 'no-referrer';
          img.onerror = function () { thumb.remove(); };
          thumb.appendChild(img);
          link.appendChild(thumb);
        }

        var body = el('span', 'rf-news__body');
        var meta = el('span', 'rf-news__meta');

        if (showSource && item.source) {
          meta.appendChild(el('span', 'rf-news__source', item.source));
        }
        if (showDate && item.publishedAt) {
          var time = el('time', 'rf-news__date', formatDate(item.publishedAt));
          time.dateTime = item.publishedAt;
          meta.appendChild(time);
        }
        if (meta.childNodes.length) body.appendChild(meta);

        body.appendChild(el('span', 'rf-news__title', item.title));
        if (item.summary) {
          body.appendChild(el('span', 'rf-news__summary', item.summary));
        }

        if (linkLabel) {
          var cta = el('span', 'rf-news__cta', linkLabel);
          var arrow = el('span', 'rf-news__arrow', '→');
          arrow.setAttribute('aria-hidden', 'true');
          cta.appendChild(arrow);
          body.appendChild(cta);
        }

        link.appendChild(body);

        var card = el('li', 'rf-news__card');
        card.appendChild(link);
        target.appendChild(card);
      });

      target.hidden = false;
      if (empty) empty.remove();

      if (updated && data.generatedAt) {
        updated.textContent = 'Updated ' + formatDate(data.generatedAt);
        updated.hidden = false;
      }
    }

    fetch(jsonUrl, { cache: 'no-cache' })
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(render)
      .catch(function () {
        if (empty) empty.textContent = 'Headlines are temporarily unavailable.';
      });
  })();
</script>

{% schema %}
{
  "name": "3D Printing News",
  "tag": "section",
  "class": "rf-news-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3D Printing News"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The week in additive manufacturing, gathered from the industry's leading publications."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link text",
      "default": "Read article",
      "info": "Leave empty to hide the link line. Matches the \"Learn More →\" style used elsewhere on the site."
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Headlines to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show article images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_source",
      "label": "Show publication name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5BC2EC",
      "info": "Used for the publication name, the card link and hover borders."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e3e6ea"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Headings",
      "default": "#3f3f46"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Body text",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "paragraph",
      "content": "Headlines come from the shop metafield rendr.news_3d_printing. Only set a fallback URL if you are not pushing to the metafield."
    },
    {
      "type": "text",
      "id": "json_url",
      "label": "Fallback JSON URL",
      "info": "Optional. Used only when the metafield is empty."
    }
  ],
  "presets": [
    {
      "name": "3D Printing News"
    }
  ]
}
{% endschema %}
